# ==========================================
# CAMPUS INFRASTRUCTURE INTELLIGENCE - ENV VARS
# ==========================================

# 1. APPLICATION CONFIGURATION
NODE_ENV=production
PORT=3001
FRONTEND_URL="https://your-app.vercel.app"
BACKEND_URL="https://your-backend.onrender.com"

# Next.js Client Environment Variables
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"
NEXT_PUBLIC_WS_URL="https://your-backend.onrender.com"

# 2. DATABASE CONFIGURATION (Supabase PostgreSQL / Hosted Postgres)
# Format: postgresql://[user]:[password]@[host]:5432/[dbname]?schema=public
DATABASE_URL="postgresql://postgres:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres?schema=public"

# 3. AUTHENTICATION & SECURITY
JWT_ACCESS_SECRET="your-secure-production-access-token-secret"
JWT_REFRESH_SECRET="your-secure-production-refresh-token-secret"
JWT_EXPIRES_IN="7d"

# 4. ARTIFICIAL INTELLIGENCE PROVIDERS (Server-Side Only)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# 5. CLOUDINARY FILE & IMAGE STORAGE
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 6. EMAIL & NOTIFICATIONS (SMTP Configuration)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@campus.edu"
SMTP_PASS="your-smtp-app-password"
APP_URL="https://your-app.vercel.app"
