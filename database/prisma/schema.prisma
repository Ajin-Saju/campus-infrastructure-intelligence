generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]

  @@index([name])
  @@index([deletedAt])
  @@map("roles")
}

model User {
  id                        String              @id @default(uuid())
  email                     String              @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  phone                     String?
  avatarUrl                 String?
  roleId                    String
  departmentId              String?
  isActive                  Boolean             @default(true)
  isEmailVerified           Boolean             @default(false)
  verificationToken         String?
  verificationTokenExpires  DateTime?
  resetPasswordToken        String?
  resetPasswordTokenExpires DateTime?
  refreshTokenHash          String?
  lastLoginAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  activityLogs              ActivityLog[]
  uploadedAssetImages       AssetImage[]        @relation("UploadedByUser")
  attachments               Attachment[]        @relation("UploadedByUser")
  issueComments             IssueComment[]
  uploadedIssueImages       IssueImage[]        @relation("UploadedByUser")
  reportedIssues            IssueReport[]       @relation("ReportedByUser")
  assignedTasks             MaintenanceTask[]   @relation("AssignedToUser")
  maintenanceUpdates        MaintenanceUpdate[] @relation("UpdatedByUser")
  notifications             Notification[]
  performedRepairs          RepairHistory[]     @relation("PerformedByUser")
  department                Department?         @relation(fields: [departmentId], references: [id])
  role                      Role                @relation(fields: [roleId], references: [id])
  vendorAssignments         VendorAssignment[]  @relation("AssignedByUser")

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@index([deletedAt])
  @@map("users")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  assets      Asset[]
  buildings   Building[]
  users       User[]

  @@index([name])
  @@index([code])
  @@index([deletedAt])
  @@map("departments")
}

model Building {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  address      String?
  latitude     Float?
  longitude    Float?
  departmentId String?
  totalFloors  Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  assets       Asset[]
  department   Department?   @relation(fields: [departmentId], references: [id])
  floors       Floor[]
  issueReports IssueReport[]
  rooms        Room[]

  @@index([code])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("buildings")
}

model Floor {
  id          String    @id @default(uuid())
  buildingId  String
  floorNumber Int
  name        String
  mapUrl      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assets      Asset[]
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms       Room[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
  @@index([deletedAt])
  @@map("floors")
}

model Room {
  id           String        @id @default(uuid())
  buildingId   String
  floorId      String
  roomNumber   String
  name         String?
  type         String        @default("CLASSROOM")
  capacity     Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  assets       Asset[]
  issueReports IssueReport[]
  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([buildingId, roomNumber])
  @@index([buildingId])
  @@index([floorId])
  @@index([deletedAt])
  @@map("rooms")
}

model AssetCategory {
  id            String          @id @default(uuid())
  name          String          @unique
  code          String          @unique
  description   String?
  parentId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  parent        AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subCategories AssetCategory[] @relation("CategoryHierarchy")
  assets        Asset[]

  @@index([name])
  @@index([code])
  @@index([parentId])
  @@index([deletedAt])
  @@map("asset_categories")
}

model Asset {
  id                    String            @id @default(uuid())
  assetTag              String            @unique
  name                  String
  description           String?
  categoryId            String
  departmentId          String?
  buildingId            String?
  floorId               String?
  roomId                String?
  status                AssetStatus       @default(OPERATIONAL)
  serialNumber          String?
  modelNumber           String?
  manufacturer          String?
  purchaseDate          DateTime?
  purchaseCost          Decimal?          @db.Decimal(12, 2)
  warrantyExpiry        DateTime?
  expectedLifespanYears Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  aiPredictions         AIPrediction[]
  images                AssetImage[]
  qrCode                AssetQRCode?
  building              Building?         @relation(fields: [buildingId], references: [id])
  category              AssetCategory     @relation(fields: [categoryId], references: [id])
  department            Department?       @relation(fields: [departmentId], references: [id])
  floor                 Floor?            @relation(fields: [floorId], references: [id])
  room                  Room?             @relation(fields: [roomId], references: [id])
  issueReports          IssueReport[]
  maintenanceTasks      MaintenanceTask[]
  repairHistories       RepairHistory[]

  @@index([assetTag])
  @@index([categoryId])
  @@index([departmentId])
  @@index([buildingId])
  @@index([roomId])
  @@index([status])
  @@index([deletedAt])
  @@map("assets")
}

model AssetImage {
  id           String    @id @default(uuid())
  assetId      String
  url          String
  caption      String?
  isPrimary    Boolean   @default(false)
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation("UploadedByUser", fields: [uploadedById], references: [id])

  @@index([assetId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("asset_images")
}

model AssetQRCode {
  id          String    @id @default(uuid())
  assetId     String    @unique
  qrCodeData  String    @unique
  qrImageUrl  String?
  generatedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([qrCodeData])
  @@index([deletedAt])
  @@map("asset_qr_codes")
}

model IssueCategory {
  id              String        @id @default(uuid())
  name            String        @unique
  code            String        @unique
  description     String?
  defaultPriority IssuePriority @default(MEDIUM)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  issueReports    IssueReport[]

  @@index([name])
  @@index([code])
  @@index([deletedAt])
  @@map("issue_categories")
}

model IssueReport {
  id               String            @id @default(uuid())
  ticketNumber     String            @unique
  title            String
  description      String
  categoryId       String
  priority         IssuePriority     @default(MEDIUM)
  status           IssueStatus       @default(OPEN)
  reportedById     String
  assetId          String?
  roomId           String?
  buildingId       String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  aiPredictions    AIPrediction[]
  attachments      Attachment[]
  comments         IssueComment[]
  images           IssueImage[]
  asset            Asset?            @relation(fields: [assetId], references: [id])
  building         Building?         @relation(fields: [buildingId], references: [id])
  category         IssueCategory     @relation(fields: [categoryId], references: [id])
  reportedBy       User              @relation("ReportedByUser", fields: [reportedById], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  maintenanceTasks MaintenanceTask[]

  @@index([ticketNumber])
  @@index([categoryId])
  @@index([reportedById])
  @@index([assetId])
  @@index([buildingId])
  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("issue_reports")
}

model IssueImage {
  id            String      @id @default(uuid())
  issueReportId String
  url           String
  caption       String?
  uploadedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  issueReport   IssueReport @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  uploadedBy    User?       @relation("UploadedByUser", fields: [uploadedById], references: [id])

  @@index([issueReportId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("issue_images")
}

model IssueComment {
  id            String      @id @default(uuid())
  issueReportId String
  userId        String
  content       String
  isInternal    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  issueReport   IssueReport @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@index([issueReportId])
  @@index([userId])
  @@index([deletedAt])
  @@map("issue_comments")
}

model MaintenanceTask {
  id                 String              @id @default(uuid())
  taskNumber         String              @unique
  title              String
  description        String?
  issueReportId      String?
  assetId            String?
  assignedToId       String?
  vendorId           String?
  type               TaskType            @default(CORRECTIVE)
  status             TaskStatus          @default(PENDING)
  priority           IssuePriority       @default(MEDIUM)
  scheduledStartDate DateTime?
  scheduledEndDate   DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  estimatedCost      Decimal?            @db.Decimal(12, 2)
  actualCost         Decimal?            @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attachments        Attachment[]
  asset              Asset?              @relation(fields: [assetId], references: [id])
  assignedTo         User?               @relation("AssignedToUser", fields: [assignedToId], references: [id])
  issueReport        IssueReport?        @relation(fields: [issueReportId], references: [id])
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  updates            MaintenanceUpdate[]
  repairHistories    RepairHistory[]
  vendorAssignments  VendorAssignment[]

  @@index([taskNumber])
  @@index([issueReportId])
  @@index([assetId])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("maintenance_tasks")
}

model MaintenanceUpdate {
  id                 String          @id @default(uuid())
  taskId             String
  updatedById        String
  statusFrom         TaskStatus?
  statusTo           TaskStatus
  notes              String
  progressPercentage Int?
  costIncurred       Decimal?        @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  task               MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedBy          User            @relation("UpdatedByUser", fields: [updatedById], references: [id])

  @@index([taskId])
  @@index([updatedById])
  @@index([deletedAt])
  @@map("maintenance_updates")
}

model RepairHistory {
  id            String           @id @default(uuid())
  assetId       String
  taskId        String?
  performedById String?
  vendorId      String?
  repairDate    DateTime
  description   String
  partsReplaced String?
  cost          Decimal          @db.Decimal(12, 2)
  downtimeHours Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  asset         Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy   User?            @relation("PerformedByUser", fields: [performedById], references: [id])
  task          MaintenanceTask? @relation(fields: [taskId], references: [id])
  vendor        Vendor?          @relation(fields: [vendorId], references: [id])

  @@index([assetId])
  @@index([taskId])
  @@index([performedById])
  @@index([vendorId])
  @@index([repairDate])
  @@index([deletedAt])
  @@map("repair_history")
}

model Vendor {
  id                String             @id @default(uuid())
  companyName       String
  contactName       String?
  email             String             @unique
  phone             String
  address           String?
  serviceTypes      Json?
  rating            Float?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  maintenanceTasks  MaintenanceTask[]
  repairHistories   RepairHistory[]
  vendorAssignments VendorAssignment[]

  @@index([companyName])
  @@index([email])
  @@index([deletedAt])
  @@map("vendors")
}

model VendorAssignment {
  id             String                 @id @default(uuid())
  vendorId       String
  taskId         String
  assignedById   String
  status         VendorAssignmentStatus @default(REQUESTED)
  assignedAt     DateTime               @default(now())
  completedAt    DateTime?
  contractAmount Decimal?               @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  assignedBy     User                   @relation("AssignedByUser", fields: [assignedById], references: [id])
  task           MaintenanceTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([taskId])
  @@index([assignedById])
  @@index([status])
  @@index([deletedAt])
  @@map("vendor_assignments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([deletedAt])
  @@map("notifications")
}

model ActivityLog {
  id         String    @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("activity_logs")
}

model Attachment {
  id                String           @id @default(uuid())
  fileName          String
  fileUrl           String
  fileType          String
  fileSize          Int
  uploadedById      String
  issueReportId     String?
  maintenanceTaskId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  issueReport       IssueReport?     @relation(fields: [issueReportId], references: [id])
  maintenanceTask   MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id])
  uploadedBy        User             @relation("UploadedByUser", fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([issueReportId])
  @@index([maintenanceTaskId])
  @@index([deletedAt])
  @@map("attachments")
}

model AIPrediction {
  id              String           @id @default(uuid())
  assetId         String?
  issueReportId   String?
  predictionType  AIPredictionType
  confidenceScore Float
  predictedValue  String
  recommendation  String?
  modelMetadata   Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  asset           Asset?           @relation(fields: [assetId], references: [id])
  issueReport     IssueReport?     @relation(fields: [issueReportId], references: [id])

  @@index([assetId])
  @@index([issueReportId])
  @@index([predictionType])
  @@index([deletedAt])
  @@map("ai_predictions")
}

model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  category    String    @default("GENERAL")
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([key])
  @@index([category])
  @@index([deletedAt])
  @@map("system_settings")
}

enum AssetStatus {
  OPERATIONAL
  NEEDS_REPAIR
  IN_MAINTENANCE
  DECOMMISSIONED
  SCRAPPED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum TaskType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VendorAssignmentStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ISSUE_UPDATE
  TASK_ASSIGNMENT
  SLA_BREACH
  SYSTEM
  MAINTENANCE_REMINDER
}

enum AIPredictionType {
  FAILURE_RISK
  MAINTENANCE_NEEDED
  PRIORITY_RECOMMENDATION
  COST_ESTIMATE
}
