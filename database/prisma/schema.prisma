// Prisma Schema Configuration for Campus Infrastructure Intelligence
// Datasource and Client Generator Setup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum AssetStatus {
  OPERATIONAL
  NEEDS_REPAIR
  IN_MAINTENANCE
  DECOMMISSIONED
  SCRAPPED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum TaskType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VendorAssignmentStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ISSUE_UPDATE
  TASK_ASSIGNMENT
  SLA_BREACH
  SYSTEM
  MAINTENANCE_REMINDER
}

enum AIPredictionType {
  FAILURE_RISK
  MAINTENANCE_NEEDED
  PRIORITY_RECOMMENDATION
  COST_ESTIMATE
}

// ==========================================
// MODELS
// ==========================================

// 1. Roles Table
model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  permissions Json?     // Array of permission strings or object
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@index([name])
  @@index([deletedAt])
  @@map("roles")
}

// 2. Users Table
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  roleId       String
  departmentId String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  role                   Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department             Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportedIssues         IssueReport[]       @relation("ReportedByUser")
  assignedTasks          MaintenanceTask[]   @relation("AssignedToUser")
  issueComments          IssueComment[]
  maintenanceUpdates     MaintenanceUpdate[] @relation("UpdatedByUser")
  uploadedAssetImages    AssetImage[]        @relation("UploadedByUser")
  uploadedIssueImages    IssueImage[]        @relation("UploadedByUser")
  vendorAssignments      VendorAssignment[]  @relation("AssignedByUser")
  performedRepairs       RepairHistory[]     @relation("PerformedByUser")
  notifications          Notification[]
  activityLogs           ActivityLog[]
  attachments            Attachment[]        @relation("UploadedByUser")

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("users")
}

// 3. Departments Table
model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users     User[]
  buildings Building[]
  assets    Asset[]

  @@index([name])
  @@index([code])
  @@index([deletedAt])
  @@map("departments")
}

// 4. Buildings Table
model Building {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  address      String?
  latitude     Float?
  longitude    Float?
  departmentId String?
  totalFloors  Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  floors       Floor[]
  rooms        Room[]
  assets       Asset[]
  issueReports IssueReport[]

  @@index([code])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("buildings")
}

// 5. Floors Table
model Floor {
  id          String    @id @default(uuid())
  buildingId  String
  floorNumber Int
  name        String
  mapUrl      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]
  assets   Asset[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
  @@index([deletedAt])
  @@map("floors")
}

// 6. Rooms Table
model Room {
  id          String    @id @default(uuid())
  buildingId  String
  floorId     String
  roomNumber  String
  name        String?
  type        String    @default("CLASSROOM") // e.g. CLASSROOM, LAB, OFFICE, AUDITORIUM
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assets       Asset[]
  issueReports IssueReport[]

  @@unique([buildingId, roomNumber])
  @@index([buildingId])
  @@index([floorId])
  @@index([deletedAt])
  @@map("rooms")
}

// 7. Asset Categories Table
model AssetCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent        AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subCategories AssetCategory[] @relation("CategoryHierarchy")
  assets        Asset[]

  @@index([name])
  @@index([code])
  @@index([parentId])
  @@index([deletedAt])
  @@map("asset_categories")
}

// 8. Assets Table
model Asset {
  id                    String      @id @default(uuid())
  assetTag              String      @unique
  name                  String
  description           String?
  categoryId            String
  departmentId          String?
  buildingId            String?
  floorId               String?
  roomId                String?
  status                AssetStatus @default(OPERATIONAL)
  serialNumber          String?
  modelNumber           String?
  manufacturer          String?
  purchaseDate          DateTime?
  purchaseCost          Decimal?    @db.Decimal(12, 2)
  warrantyExpiry        DateTime?
  expectedLifespanYears Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  category         AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  building         Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor            Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  images           AssetImage[]
  qrCode           AssetQRCode?
  issueReports     IssueReport[]
  maintenanceTasks MaintenanceTask[]
  repairHistories  RepairHistory[]
  aiPredictions    AIPrediction[]

  @@index([assetTag])
  @@index([categoryId])
  @@index([departmentId])
  @@index([buildingId])
  @@index([roomId])
  @@index([status])
  @@index([deletedAt])
  @@map("assets")
}

// 9. Asset Images Table
model AssetImage {
  id           String    @id @default(uuid())
  assetId      String
  url          String
  caption      String?
  isPrimary    Boolean   @default(false)
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("asset_images")
}

// 10. Asset QR Codes Table
model AssetQRCode {
  id          String    @id @default(uuid())
  assetId     String    @unique
  qrCodeData  String    @unique
  qrImageUrl  String?
  generatedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([qrCodeData])
  @@index([deletedAt])
  @@map("asset_qr_codes")
}

// 11. Issue Categories Table
model IssueCategory {
  id              String        @id @default(uuid())
  name            String        @unique
  code            String        @unique
  description     String?
  defaultPriority IssuePriority @default(MEDIUM)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  issueReports IssueReport[]

  @@index([name])
  @@index([code])
  @@index([deletedAt])
  @@map("issue_categories")
}

// 12. Issue Reports Table
model IssueReport {
  id           String        @id @default(uuid())
  ticketNumber String        @unique
  title        String
  description  String
  categoryId   String
  priority     IssuePriority @default(MEDIUM)
  status       IssueStatus   @default(OPEN)
  reportedById String
  assetId      String?
  roomId       String?
  buildingId   String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  category         IssueCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reportedBy       User              @relation("ReportedByUser", fields: [reportedById], references: [id], onDelete: Restrict)
  asset            Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  building         Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  images           IssueImage[]
  comments         IssueComment[]
  maintenanceTasks MaintenanceTask[]
  aiPredictions    AIPrediction[]
  attachments      Attachment[]

  @@index([ticketNumber])
  @@index([categoryId])
  @@index([reportedById])
  @@index([assetId])
  @@index([buildingId])
  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("issue_reports")
}

// 13. Issue Images Table
model IssueImage {
  id            String    @id @default(uuid())
  issueReportId String
  url           String
  caption       String?
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  issueReport IssueReport @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([issueReportId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("issue_images")
}

// 14. Issue Comments Table
model IssueComment {
  id            String    @id @default(uuid())
  issueReportId String
  userId        String
  content       String
  isInternal    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  issueReport IssueReport @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([issueReportId])
  @@index([userId])
  @@index([deletedAt])
  @@map("issue_comments")
}

// 15. Maintenance Tasks Table
model MaintenanceTask {
  id                 String        @id @default(uuid())
  taskNumber         String        @unique
  title              String
  description        String?
  issueReportId      String?
  assetId            String?
  assignedToId       String?
  vendorId           String?
  type               TaskType      @default(CORRECTIVE)
  status             TaskStatus    @default(PENDING)
  priority           IssuePriority @default(MEDIUM)
  scheduledStartDate DateTime?
  scheduledEndDate   DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  estimatedCost      Decimal?      @db.Decimal(12, 2)
  actualCost         Decimal?      @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  issueReport       IssueReport?        @relation(fields: [issueReportId], references: [id], onDelete: SetNull)
  asset             Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedTo        User?               @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  vendor            Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  updates           MaintenanceUpdate[]
  repairHistories   RepairHistory[]
  vendorAssignments VendorAssignment[]
  attachments       Attachment[]

  @@index([taskNumber])
  @@index([issueReportId])
  @@index([assetId])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("maintenance_tasks")
}

// 16. Maintenance Updates Table
model MaintenanceUpdate {
  id                 String      @id @default(uuid())
  taskId             String
  updatedById        String
  statusFrom         TaskStatus?
  statusTo           TaskStatus
  notes              String
  progressPercentage Int?
  costIncurred       Decimal?    @db.Decimal(12, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  task      MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedBy User            @relation("UpdatedByUser", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([updatedById])
  @@index([deletedAt])
  @@map("maintenance_updates")
}

// 17. Repair History Table
model RepairHistory {
  id            String    @id @default(uuid())
  assetId       String
  taskId        String?
  performedById String?
  vendorId      String?
  repairDate    DateTime
  description   String
  partsReplaced String?
  cost          Decimal   @db.Decimal(12, 2)
  downtimeHours Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  task        MaintenanceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  performedBy User?            @relation("PerformedByUser", fields: [performedById], references: [id], onDelete: SetNull)
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([taskId])
  @@index([performedById])
  @@index([vendorId])
  @@index([repairDate])
  @@index([deletedAt])
  @@map("repair_history")
}

// 18. Vendors Table
model Vendor {
  id           String    @id @default(uuid())
  companyName  String
  contactName  String?
  email        String    @unique
  phone        String
  address      String?
  serviceTypes Json?     // Array of service categories e.g. ["HVAC", "PLUMBING"]
  rating       Float?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  maintenanceTasks  MaintenanceTask[]
  vendorAssignments VendorAssignment[]
  repairHistories   RepairHistory[]

  @@index([companyName])
  @@index([email])
  @@index([deletedAt])
  @@map("vendors")
}

// 19. Vendor Assignments Table
model VendorAssignment {
  id             String                 @id @default(uuid())
  vendorId       String
  taskId         String
  assignedById   String
  status         VendorAssignmentStatus @default(REQUESTED)
  assignedAt     DateTime               @default(now())
  completedAt    DateTime?
  contractAmount Decimal?               @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  vendor     Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  task       MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedBy User            @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([taskId])
  @@index([assignedById])
  @@index([status])
  @@index([deletedAt])
  @@map("vendor_assignments")
}

// 20. Notifications Table
model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([deletedAt])
  @@map("notifications")
}

// 21. Activity Logs Table
model ActivityLog {
  id         String    @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("activity_logs")
}

// 22. Attachments Table
model Attachment {
  id                String    @id @default(uuid())
  fileName          String
  fileUrl           String
  fileType          String
  fileSize          Int
  uploadedById      String
  issueReportId     String?
  maintenanceTaskId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  uploadedBy      User             @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  issueReport     IssueReport?     @relation(fields: [issueReportId], references: [id], onDelete: SetNull)
  maintenanceTask MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@index([issueReportId])
  @@index([maintenanceTaskId])
  @@index([deletedAt])
  @@map("attachments")
}

// 23. AI Predictions Table
model AIPrediction {
  id               String           @id @default(uuid())
  assetId          String?
  issueReportId    String?
  predictionType   AIPredictionType
  confidenceScore Float
  predictedValue   String
  recommendation   String?
  modelMetadata    Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  issueReport IssueReport? @relation(fields: [issueReportId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([issueReportId])
  @@index([predictionType])
  @@index([deletedAt])
  @@map("ai_predictions")
}

// 24. System Settings Table
model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  category    String    @default("GENERAL")
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([key])
  @@index([category])
  @@index([deletedAt])
  @@map("system_settings")
}
